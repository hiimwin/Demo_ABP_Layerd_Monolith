    },
    "abpSourceCode.Domain.Shared": {
      "path": "src/abpSourceCode.Domain.Shared/abpSourceCode.Domain.Shared.abppkg",
      "folder": "src"
    },
    "abpSourceCode.Application.Contracts": {
      "path": "src/abpSourceCode.Application.Contracts/abpSourceCode.Application.Contracts.abppkg",
      "folder": "src"
    },
    "abpSourceCode.HttpApi": {
      "path": "src/abpSourceCode.HttpApi/abpSourceCode.HttpApi.abppkg",
      "folder": "src"
    },
    "abpSourceCode.HttpApi.Client": {
      "path": "src/abpSourceCode.HttpApi.Client/abpSourceCode.HttpApi.Client.abppkg",
      "folder": "src"
    },
    "abpSourceCode.EntityFrameworkCore": {
      "path": "src/abpSourceCode.EntityFrameworkCore/abpSourceCode.EntityFrameworkCore.abppkg",
      "folder": "src"
    },
    "abpSourceCode.DbMigrator": {
      "path": "src/abpSourceCode.DbMigrator/abpSourceCode.DbMigrator.abppkg",
      "folder": "src"
    },
    "abpSourceCode.HttpApi.Host": {
      "path": "src/abpSourceCode.HttpApi.Host/abpSourceCode.HttpApi.Host.abppkg",
      "folder": "src"
    },
    "abpSourceCode.Domain": {
      "path": "src/abpSourceCode.Domain/abpSourceCode.Domain.abppkg",
      "folder": "src"
    }
